{
  "name": "scenic-aigc",
  "version": "1.0.0",
  "private": true,
  "description": "景区 AI 旅拍：打卡合拍、AI 换装照片 / 视频，游客 · 商户 · 管理员三端",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm install && npm --prefix web install",
    "dev": "node --env-file-if-exists=.env --watch-path=server server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed:reset": "node --env-file-if-exists=.env server/seed.js --reset",
    "test": "node --env-file-if-exists=.env --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "sharp": "^0.34.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "sharp@0.34.5": true
  }
}
