# 复制为 .env 后按需修改（npm start / npm run dev 会自动读取）

PORT=3000
# 数据目录（SQLite 数据库与上传文件），默认 ./data
# DATA_DIR=./data
# 用于签名私有文件链接；不填则自动生成并保存在 data/.secret
# APP_SECRET=
# 登录有效天数
# SESSION_DAYS=7

# AI 提供方：mock（本地模拟，不消耗任何余额）或 runninghub
AI_PROVIDER=mock
# 同时制作的订单数
WORKER_CONCURRENCY=2
# 模拟制作速度倍率（越小越快，仅 mock 有效）
# MOCK_SPEED=1

# RunningHub（AI_PROVIDER=runninghub 时生效；工作流映射见 config/runninghub.example.json）
# RUNNINGHUB_API_KEY=
# RUNNINGHUB_BASE_URL=https://www.runninghub.cn
# RUNNINGHUB_WORKFLOWS=./config/runninghub.json

# 可选：自定义 ffmpeg 路径（默认使用 ffmpeg-static）
# FFMPEG_PATH=

# 首次初始化时三个测试账号的密码（不填则使用默认测试密码）
# SEED_USER_PASSWORD=
# SEED_MERCHANT_PASSWORD=
# SEED_ADMIN_PASSWORD=
